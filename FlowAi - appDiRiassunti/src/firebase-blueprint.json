{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the StudyFlow AI application.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique Firebase Auth ID." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's full name." },
        "photoURL": { "type": "string", "description": "URL to user's profile picture." },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User's role in the system." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user account was created." }
      },
      "required": ["uid", "email", "role"]
    },
    "Analysis": {
      "title": "Analysis",
      "description": "A text analysis result performed by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user who performed the analysis." },
        "content": { "type": "string", "description": "The original text or URL analyzed." },
        "type": { "type": "string", "enum": ["text", "url"], "description": "The type of input." },
        "summary": { "type": "string", "description": "The AI-generated summary." },
        "concepts": { "type": "array", "items": { "type": "string" }, "description": "Extracted key concepts." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the analysis was performed." }
      },
      "required": ["userId", "content", "type", "summary", "concepts", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/analyses/{analysisId}": {
      "schema": "Analysis",
      "description": "History of analyses performed by users."
    }
  }
}
